{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "mac-clang-release",
      "displayName": "Mac Clang Release",
      "description": "针对 macOS 的 Clang 编译，优化性能",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      }
    },
    {
      "name": "mac-clang-beta",
      "displayName": "Mac Clang Beta",
      "description": "针对 macOS 的 Clang 编译，保留调试符号",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux GCC Release",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "win-mingw-release",
      "displayName": "Win MinGW Release",
      "description": "Qt 的 mingw_64 套件，使用 MinGW 自带的 g++",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "win-llvm-mingw-release",
      "displayName": "Win LLVM-MinGW Release",
      "description": "Qt 6.10 的 llvm-mingw_64 套件，使用 LLVM-MinGW 的 clang++",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "environment": {
        "PATH": "C:/Qt/Tools/llvm-mingw1706_64/bin;C:/Qt/Tools/Ninja;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.10.3/llvm-mingw_64",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mac-release",
      "configurePreset": "mac-clang-release"
    },
    {
      "name": "mac-beta",
      "configurePreset": "mac-clang-beta"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-gcc-release"
    },
    {
      "name": "win-release",
      "configurePreset": "win-mingw-release"
    },
    {
      "name": "win-llvm-release",
      "configurePreset": "win-llvm-mingw-release"
    }
  ]
}
