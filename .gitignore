# =============================================
# QueMusic — .gitignore
# =============================================

# --- Build Output ---
build*/
cmake-build-*/
out/

# --- IDE / Editor ---
.idea/
.vscode/
.qtcreator/
*.user
*.user.*
CMakeLists.txt.user*
*.swp
*.swo
*~

# --- OS Artifacts ---
.DS_Store
Thumbs.db
Desktop.ini
*.bak

# --- Qt Creator Specific ---
*.autosave
*.autosave.qml
*.orig

# --- Compiled Binaries ---
*.exe
*.dll
*.so
*.dylib
*.lib
*.a
*.obj
*.o

# --- Archives ---
*.zip
*.tar
*.gz
*.rar
*.7z

# --- Temp & Logs ---
*.log
*.tmp
temp/
logs/

# --- QML Cache ---
.qmlc/
*.qmlc
*.jsc

# --- Third-party build dirs ---
ThirdParty/*/build/

# --- 打包产物 ---
dist/
*.msix
*.msixupload

# --- Linux 打包中间产物 ---
AppDir/
squashfs-root/
fcitx5-qt/

# --- Python / Node ---
node_modules/
__pycache__/
*.pyc

# --- FFmpeg 开发文件随仓库提供 ---
# 只入库头文件、导入库与许可证；运行库 dll 用 Qt 自带的那套，不再入库。
# 例外必须排在上面 "*.a" 规则之后（git 忽略规则顺序敏感）。
!ffmpeg/lib/*.dll.a

